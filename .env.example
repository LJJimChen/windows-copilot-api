# Configuration for the Copilot bridge.
# Copy to `.env` and edit; it is loaded automatically by python-dotenv.
# Real environment variables take precedence over this file.

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- rate limiting ---------------------------------------------------------
# Requests/minute the bridge accepts (0 disables) and how many may go
# back-to-back before pacing kicks in.
RATE_LIMIT_RPM=12
RATE_LIMIT_BURST=4

# --- conversation reuse ----------------------------------------------------
# Idle seconds before a thread is forgotten, max cached threads, and the window
# in which identical history counts as a regenerate.
SESSION_TTL=1800
SESSION_MAX=64
SESSION_REGENERATE_WINDOW=300

# --- prompt diagnostics ----------------------------------------------------
# 1 prints the exact prompt sent to Copilot (on stderr).
LOG_PROMPT=0

# --- Copilot account -------------------------------------------------------
# consumer (default, copilot.com) or enterprise (Microsoft 365 Copilot).
COPILOT_PROFILE=consumer

# Browser used only for interactive sign-in: msedge (default), chrome,
# msedge-beta, chrome-beta, bundled, or an absolute path.
# COPILOT_BROWSER_CHANNEL=msedge
# COPILOT_BROWSER_EXECUTABLE=

# Extra hosts treated as "still signing in", comma-separated (ADFS, Okta, ...).
# COPILOT_LOGIN_HOSTS=

# --- profile overrides -----------------------------------------------------
# Leave commented to use the selected profile's preset. Set these only when a
# value needs correcting without editing code.
# COPILOT_TENANT=
# COPILOT_WEB_ORIGIN=
# COPILOT_CHAT_URL=
# COPILOT_LICENSE_TYPE=
# COPILOT_SCENARIO=
# COPILOT_SOURCE=
# COPILOT_PRODUCT=
# COPILOT_AGENT_HOST=
# COPILOT_AGENT=
# COPILOT_IS_EDU=
# COPILOT_CLIENT_PLATFORM=
# COPILOT_CLIENT_ENTRYPOINT=
# COPILOT_BROKER_CLIENT_ID=
# COPILOT_BROKER_REDIRECT_URI=
